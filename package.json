{
  "name": "neural-band-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "desktop": "tsc -p electron/tsconfig.json && concurrently -k \"vite --host 127.0.0.1 --port 5190 --strictPort\" \"wait-on http://127.0.0.1:5190 && electron . --dev\"",
    "build": "tsc --noEmit && tsc -p electron/tsconfig.json && vite build",
    "start": "electron .",
    "test:python": ".venv/bin/python -m unittest discover -s tests",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:motions": "node scripts/motions-smoke.mjs",
    "test:api": "node scripts/api-smoke.mjs",
    "test:startup": "node scripts/startup-smoke.mjs",
    "package:mac": "node scripts/create-icons.mjs && npm run build && python3 scripts/package-macos.py"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.1.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
